from spam import check_spam
from strikes import add_strike
from welcome import welcome
from queues.actions import queue_action


# ============================================================
# CONFIGURATION
# ============================================================

MUTE_SECONDS = 300
ADMIN_CACHE_TTL = 60

# Maximum pending AI jobs.
# This prevents a large message burst from creating unlimited
# background tasks.
AI_QUEUE_SIZE = 500
MEDIA_QUEUE_SIZE = 100

# Number of concurrent AI workers.
TEXT_AI_WORKERS = 4
MEDIA_AI_WORKERS = 2

# Warning/action protection.
ACTION_CACHE_TTL = 15


# ============================================================
# FAST LOCAL RULES
# ============================================================

INSTANT_BLOCK_WORDS = [
    "tmkc",
    "bsdk",
    "madarchot",
    "bhosadike",
    "bkl",
    "mdrcd",
    "mdrchd",
    "behenchot",
    "bhenchod",
    "chutiya",
    "gandu",
    "laude",
    "loda",
    "mms",
    "sex video",
    "adult video",
    "hot video",
    "dm me",
    "inbox me",
    "come inbox",
    "pm me",
    "want fun",
    "video call",
    "whatsapp number",
    "telegram dm",
]

PROMOTION_PHRASES = [
    "link in bio",
    "check bio",
    "dm me",
    "add me on",
    "telegram.me",
    "t.me",
    "whatsapp",
    "snapchat",
]

RESTRICTED_STICKER_EMOJIS = {
    "🖕",
    "🤬",
    "💩",
}


# Pre-normalize once.
NORMALIZED_INSTANT_WORDS = tuple(
    re.sub(r"[\s\-_.,]+", "", word.lower())
    for word in INSTANT_BLOCK_WORDS
)


# ============================================================
# RUNTIME STATE
# ============================================================

# chat_id -> {
#     "admins": set(user_ids),
#     "timestamp": float
# }
admin_cache = {}

# user_id -> recent sticker timestamps
user_sticker_timestamps = defaultdict(list)

STICKER_RATE_LIMIT_COUNT = 3
STICKER_RATE_LIMIT_WINDOW = 5.0

# Prevent duplicate punishments for the same message.
# key = (chat_id, message_id)
recent_actions = {}


# ============================================================
# HEALTH CHECK SERVER
# ============================================================

from http.server import BaseHTTPRequestHandler, HTTPServer


class HealthCheckHandler(BaseHTTPRequestHandler):

    def do_GET(self):
        self.send_response(200)
        self.send_header("Content-Type", "text/plain")
        self.end_headers()
        self.wfile.write(b"Bot is active!")

    def log_message(self, format, *args):
        return


def run_http_server():
    port = int(os.environ.get("PORT", "10000"))

    server = HTTPServer(
        ("0.0.0.0", port),
        HealthCheckHandler,
    )

    print(f"Health server listening on port {port}")

    server.serve_forever()


def start_keep_alive():
    thread = threading.Thread(
        target=run_http_server,
        daemon=True,
    )

    thread.start()


# ============================================================
# BASIC FILTERS
# ============================================================

def allowed_chat(chat_id: int) -> bool:
    if not ALLOWED_GROUPS:
        return True

    return chat_id in ALLOWED_GROUPS


def normalize_text(text: str) -> str:
    return re.sub(
        r"[\s\-_.,]+",
        "",
        text.lower(),
    )


def contains_instant_block(text: str) -> bool:
    if not text:
        return False

    text_lower = text.lower()

    # Normal form.
    for word in INSTANT_BLOCK_WORDS:
        if word in text_lower:
            return True

    # Evasion form.
    clean = normalize_text(text)

    for word in NORMALIZED_INSTANT_WORDS:
        if len(word) > 2 and word in clean:
            return True

    return False


def contains_promotion(text: str) -> bool:
    if not text:
        return False

    text_lower = text.lower()

    return any(
        phrase in text_lower
        for phrase in PROMOTION_PHRASES
    )


def has_excessive_special_chars(text: str) -> bool:
    if not text:
        return False

    special_count = len(
        re.findall(
            r"[^a-zA-Z0-9\s]",
            text,
        )
    )

    return special_count > 2


# ============================================================
# ADMIN CACHE
# ============================================================

async def refresh_admin_cache(chat):
    """
    Fetch all administrators once per chat and cache their IDs.

    This avoids calling get_member() separately for every user.
    """

    now = time.monotonic()

    cached = admin_cache.get(chat.id)

    if cached:
        age = now - cached["timestamp"]

        if age < ADMIN_CACHE_TTL:
            return cached["admins"]

    try:
        administrators = await chat.get_administrators()

        admin_ids = {
            member.user.id
            for member in administrators
        }

        admin_cache[chat.id] = {
            "admins": admin_ids,
            "timestamp": now,
        }

        logging.info(
            "Refreshed admin cache for chat %s (%d admins)",
            chat.id,
            len(admin_ids),
        )

        return admin_ids

    except TelegramError as error:
        logging.warning(
            "Could not refresh admin cache for %s: %s",
            chat.id,
            error,
        )

        # If an older cache exists, keep using it.
        if cached:
            return cached["admins"]

        return set()

    except Exception:
        logging.exception(
            "Unexpected admin-cache error for chat %s",
            chat.id,
        )

        if cached:
            return cached["admins"]

        return set()


async def is_admin(chat, user_id: int) -> bool:
    admins = await refresh_admin_cache(chat)

    return user_id in admins


# ============================================================
# ACTION DEDUPLICATION
# ============================================================

def action_key(chat_id: int, message_id: int):
    return (chat_id, message_id)


def action_already_started(chat_id: int, message_id: int) -> bool:
    now = time.monotonic()

    # Cleanup old entries.
    expired = [
        key
        for key, timestamp in recent_actions.items()
        if now - timestamp > ACTION_CACHE_TTL
    ]

    for key in expired:
        recent_actions.pop(key, None)

    key = action_key(chat_id, message_id)

    if key in recent_actions:
        return True

    recent_actions[key] = now

    return False


# ============================================================
# MODERATION ACTION
# ============================================================

async def punish_user(
    update: Update,
    context: ContextTypes.DEFAULT_TYPE,
    chat,
    user,
    reason: str,
):
    """
    Delete the offending message and restrict the user for 5 minutes.
    """

    message = update.effective_message

    if not message:
        return False

    if action_already_started(
        chat.id,
        message.message_id,
    ):
        return False

    # --------------------------------------------------------
    # DELETE
    # --------------------------------------------------------

    try:
        await message.delete()

    except BadRequest:
        # Message may already have been deleted.
        pass

    except TelegramError as error:
        logging.warning(
            "Could not delete message %s: %s",
            message.message_id,
            error,
        )

    # --------------------------------------------------------
    # MUTE
    # --------------------------------------------------------

    try:
        mute_until = int(time.time()) + MUTE_SECONDS

        await context.bot.restrict_chat_member(
            chat_id=chat.id,
            user_id=user.id,
            permissions=ChatPermissions(
                can_send_messages=False,
            ),
            until_date=mute_until,
        )

    except TelegramError as error:
        logging.warning(
            "Could not mute user %s: %s",
            user.id,
            error,
        )

    except Exception:
        logging.exception(
            "Unexpected restriction error"
        )

    # --------------------------------------------------------
    # WARNING
    # --------------------------------------------------------

    try:
        warning = await context.bot.send_message(
            chat_id=chat.id,
            text=(
                f"⚠️ **{user.full_name}** was muted for "
                f"5 minutes.\n\n"
                f"**Reason:** {reason}"
            ),
            parse_mode="Markdown",
        )

        # Delete warning later without blocking moderation.
        asyncio.create_task(
            delete_warning_later(
                context,
                chat.id,
                warning.message_id,
                15,
            )
        )

    except TelegramError as error:
        logging.warning(
            "Could not send warning: %s",
            error,
        )

    return True


async def delete_warning_later(
    context,
    chat_id: int,
    message_id: int,
    delay: int,
):
    await asyncio.sleep(delay)

    try:
        await context.bot.delete_message(
            chat_id=chat_id,
            message_id=message_id,
        )

    except TelegramError:
        pass


# ============================================================
# LOGGING
# ============================================================

async def async_log_pipeline(
    context,
    chat_id,
    user,
    reason,
    severity,
    is_strike=True,
):
    """
    Logging runs in the background so database/log operations
    don't slow down moderation.
    """

    try:
        name = user.username or user.full_name

        if is_strike:
            result = add_strike(
                chat_id,
                user.id,
                name,
                reason,
            )

            action = result[1]
        else:
            action = "mute"

        save_log(
            chat_id,
            user.id,
            action,
            reason,
            severity,
        )

        await send_log(
            context,
            name,
            user.id,
            action,
            reason,
            severity,
        )

    except Exception:
        logging.exception(
            "Logging pipeline failed"
        )


# ============================================================
# STICKER FLOOD
# ============================================================

def check_sticker_flood(user_id: int) -> bool:
    now = time.monotonic()

    timestamps = user_sticker_timestamps[user_id]

    timestamps[:] = [
        timestamp
        for timestamp in timestamps
        if now - timestamp < STICKER_RATE_LIMIT_WINDOW
    ]

    timestamps.append(now)

    return len(timestamps) > STICKER_RATE_LIMIT_COUNT


# ============================================================
# STICKER HANDLER
# ============================================================

async def handle_sticker(
    update: Update,
    context: ContextTypes.DEFAULT_TYPE,
):
    message = update.effective_message

    if not message or not message.sticker:
        return

    chat = update.effective_chat
    user = update.effective_user

    if not chat or not user:
        return

    if chat.type == "private":
        return

    if not allowed_chat(chat.id):
        return

    if user.is_bot:
        return

    if await is_admin(chat, user.id):
        return

    sticker = message.sticker

    # Fast restricted emoji check.
    if sticker.emoji in RESTRICTED_STICKER_EMOJIS:
        reason = "Restricted sticker content"

        await punish_user(
            update,
            context,
            chat,
            user,
            reason,
        )

        asyncio.create_task(
            async_log_pipeline(
                context,
                chat.id,
                user,
                reason,
                90,
            )
        )

        return

    # Fast sticker flood detection.
    if check_sticker_flood(user.id):
        reason = "Sticker flooding"

        await punish_user(
            update,
            context,
            chat,
            user,
            reason,
        )

        asyncio.create_task(
            async_log_pipeline(
                context,
                chat.id,
                user,
                reason,
                85,
            )
        )

        return

    # Put expensive AI work into media queue.
    queue = context.application.bot_data["media_queue"]

    try:
        queue.put_nowait(
            {
                "update": update,
                "chat_id": chat.id,
                "user_id": user.id,
            }
        )

    except asyncio.QueueFull:
        logging.warning(
            "Media AI queue full; skipping sticker AI check"
        )


# ============================================================
# MEDIA HANDLER
# ============================================================

async def handle_media(
    update: Update,
    context: ContextTypes.DEFAULT_TYPE,
):
    message = update.effective_message

    if not message:
        return

    chat = update.effective_chat
    user = update.effective_user

    if not chat or not user:
        return

    if chat.type == "private":
        return

    if not allowed_chat(chat.id):
        return

    if user.is_bot:
        return

    if await is_admin(chat, user.id):
        return

    caption = message.caption or ""

    caption_lower = caption.lower()

    # --------------------------------------------------------
    # FAST CAPTION CHECK
    # --------------------------------------------------------

    if (
        contains_link(caption)
        or contains_promotion(caption)
        or contains_instant_block(caption)
    ):
        reason = (
            "Prohibited text, link, or solicitation "
            "in media caption"
        )

        await punish_user(
            update,
            context,
            chat,
            user,
            reason,
        )

        asyncio.create_task(
            async_log_pipeline(
                context,
                chat.id,
                user,
                reason,
                85,
            )
        )

        return

    # --------------------------------------------------------
    # QUEUE MEDIA FOR AI
    # --------------------------------------------------------

    queue = context.application.bot_data["media_queue"]

    try:
        queue.put_nowait(
            {
                "update": update,
                "chat_id": chat.id,
                "user_id": user.id,
            }
        )

    except asyncio.QueueFull:
        logging.warning(
            "Media AI queue full; skipping media AI check"
        )


# ============================================================
# TEXT HANDLER
# ============================================================

async def handle_message(
    update: Update,
    context: ContextTypes.DEFAULT_TYPE,
):
    message = update.effective_message

    if not message:
        return

    text = message.text

    if not text:
        return

    chat = update.effective_chat
    user = update.effective_user

    if not chat or not user:
        return

    if chat.type == "private":
        return

    if not allowed_chat(chat.id):
        return

    if user.is_bot:
        return

    # --------------------------------------------------------
    # ADMIN CHECK
    # --------------------------------------------------------

    if await is_admin(chat, user.id):
        return

    text_lower = text.lower()

    # --------------------------------------------------------
    # 1. INSTANT ABUSE / ADULT / SOLICITATION
    # --------------------------------------------------------

    if contains_instant_block(text):
        reason = (
            "Use of severe abuse, insults, "
            "or adult solicitation"
        )

        await punish_user(
            update,
            context,
            chat,
            user,
            reason,
        )

        asyncio.create_task(
            async_log_pipeline(
                context,
                chat.id,
                user,
                reason,
                95,
            )
        )

        return

    # --------------------------------------------------------
    # 2. LINKS / PROMOTION
    # --------------------------------------------------------

    if (
        contains_link(text)
        or contains_promotion(text)
    ):
        reason = "Unauthorized link or promotion"

        await punish_user(
            update,
            context,
            chat,
            user,
            reason,
        )

        asyncio.create_task(
            async_log_pipeline(
                context,
                chat.id,
                user,
                reason,
                85,
            )
        )

        return

    # --------------------------------------------------------
    # 3. SPECIAL CHARACTER SPAM
    # --------------------------------------------------------

    if has_excessive_special_chars(text):
        reason = "Excessive special characters spam"

        await punish_user(
            update,
            context,
            chat,
            user,
            reason,
        )

        asyncio.create_task(
            async_log_pipeline(
                context,
                chat.id,
                user,
                reason,
                80,
            )
        )

        return

    # --------------------------------------------------------
    # 4. SPAM / FLOOD / DUPLICATES
    # --------------------------------------------------------

    spam_result = check_spam(
        chat.id,
        user.id,
        text,
    )

    if spam_result.get("spam"):
        reason = spam_result.get(
            "reason",
            "Spam detected",
        )

        severity = spam_result.get(
            "severity",
            70,
        )

        await punish_user(
            update,
            context,
            chat,
            user,
            reason,
        )

        asyncio.create_task(
            async_log_pipeline(
                context,
                chat.id,
                user,
                reason,
                severity,
            )
        )

        return

    # --------------------------------------------------------
    # 5. CONTROLLED AI QUEUE
    # --------------------------------------------------------

    queue = context.application.bot_data["ai_queue"]

    try:
        queue.put_nowait(
            {
                "update": update,
                "chat_id": chat.id,
                "user_id": user.id,
                "text": text,
            }
        )

    except asyncio.QueueFull:
        # Do NOT block the Telegram message handler.
        #
        # Local moderation has already run. If AI is overloaded,
        # the message remains subject to the fast local rules.
        logging.warning(
            "Text AI queue full; skipping AI check"
        )


# ============================================================
# AI TEXT WORKER
# ============================================================

async def ai_text_worker(
    application: Application,
    worker_number: int,
):
    queue = application.bot_data["ai_queue"]

    logging.info(
        "Text AI worker %d started",
        worker_number,
    )

    while True:
        job = await queue.get()

        try:
            update = job["update"]
            chat_id = job["chat_id"]
            user_id = job["user_id"]
            text = job["text"]

            # Don't let old queued jobs punish someone after
            # the message has already been handled.
            message = update.effective_message

            if not message:
                continue

            chat = update.effective_chat
            user = update.effective_user

            if not chat or not user:
                continue

            # Run synchronous Gemini SDK call outside event loop.
            loop = asyncio.get_running_loop()

            ai_result = await loop.run_in_executor(
                None,
                moderate_message,
                text,
            )

            if not ai_result:
                continue

            if ai_result.get("action") == "allow":
                continue

            reason = ai_result.get(
                "reason",
                "AI moderation violation",
            )

            severity = int(
                ai_result.get(
                    "severity",
                    60,
                )
            )

            punished = await punish_user(
                update,
                application,
                chat,
                user,
                reason,
            )

            if punished:
                asyncio.create_task(
                    async_log_pipeline(
                        application,
                        chat_id,
                        user,
                        reason,
                        severity,
                    )
                )

        except asyncio.CancelledError:
            raise

        except Exception:
            logging.exception(
                "Text AI worker %d error",
                worker_number,
            )

        finally:
            queue.task_done()


# ============================================================
# AI MEDIA WORKER
# ============================================================

async def ai_media_worker(
    application: Application,
    worker_number: int,
):
    queue = application.bot_data["media_queue"]

    logging.info(
        "Media AI worker %d started",
        worker_number,
    )

    while True:
        job = await queue.get()

        file_path = None

        try:
            update = job["update"]

            message = update.effective_message
            chat = update.effective_chat
            user = update.effective_user

            if not message or not chat or not user:
                continue

            # Don't waste expensive AI processing on an already
            # restricted/removed user.
            if await is_admin(chat, user.id):
                continue

            telegram_file = None
            file_ext = ".jpg"

            # ------------------------------------------------
            # Identify media
            # ------------------------------------------------

            if message.sticker:
                telegram_file = await message.sticker.get_file()
                file_ext = ".webp"

            elif message.photo:
                telegram_file = await message.photo[-1].get_file()
                file_ext = ".jpg"

            elif message.animation:
                telegram_file = await message.animation.get_file()
                file_ext = ".mp4"

            elif message.video:
                telegram_file = await message.video.get_file()
                file_ext = ".mp4"

            elif message.document:
                mime = message.document.mime_type or ""

                if (
                    "image" in mime
                    or "video" in mime
                    or mime == "application/octet-stream"
                ):
                    telegram_file = await message.document.get_file()

                    file_ext = (
                        ".mp4"
                        if "video" in mime
                        else ".jpg"
                    )

            if not telegram_file:
                continue

            # ------------------------------------------------
            # Download
            # ------------------------------------------------

            file_path = (
                f"/tmp/tgmod_{chat.id}_"
                f"{message.message_id}_"
                f"{worker_number}{file_ext}"
            )

            await telegram_file.download_to_drive(
                file_path
            )

            # ------------------------------------------------
            # Gemini vision in executor
            # ------------------------------------------------

            loop = asyncio.get_running_loop()

            ai_result = await loop.run_in_executor(
                None,
                moderate_image,
                file_path,
            )

            if not ai_result:
                continue

            if ai_result.get("action") == "allow":
                continue

            reason = ai_result.get(
                "reason",
                "Inappropriate media content",
            )

            severity = int(
                ai_result.get(
                    "severity",
                    90,
                )
            )

            punished = await punish_user(
                update,
                application,
                chat,
                user,
                reason,
            )

            if punished:
                asyncio.create_task(
                    async_log_pipeline(
                        application,
                        chat.id,
                        user,
                        reason,
                        severity,
                    )
                )

        except asyncio.CancelledError:
            raise

        except Exception:
            logging.exception(
                "Media AI worker %d error",
                worker_number,
            )

        finally:
            if file_path and os.path.exists(file_path):
                try:
                    os.remove(file_path)
                except OSError:
                    pass

            queue.task_done()


# ============================================================
# APPLICATION STARTUP
# ============================================================

async def post_init(application: Application):
    """
    Runs after Application initialization.

    Creates bounded queues and controlled worker tasks.
    """

    ai_queue = asyncio.Queue(
        maxsize=AI_QUEUE_SIZE
    )

    media_queue = asyncio.Queue(
        maxsize=MEDIA_QUEUE_SIZE
    )

    application.bot_data["ai_queue"] = ai_queue
    application.bot_data["media_queue"] = media_queue

    application.bot_data["worker_tasks"] = []

    # Text workers.
    for number in range(1, TEXT_AI_WORKERS + 1):
        task = application.create_task(
            ai_text_worker(
                application,
                number,
            ),
            name=f"text-ai-worker-{number}",
        )

        application.bot_data["worker_tasks"].append(
            task
        )

    # Media workers.
    for number in range(1, MEDIA_AI_WORKERS + 1):
        task = application.create_task(
            ai_media_worker(
                application,
                number,
            ),
            name=f"media-ai-worker-{number}",
        )

        application.bot_data["worker_tasks"].append(
            task
        )

    logging.info(
        "AI system started: %d text workers, %d media workers",
        TEXT_AI_WORKERS,
        MEDIA_AI_WORKERS,
    )


async def post_shutdown(application: Application):
    """
    Gracefully stop worker tasks.
    """

    tasks = application.bot_data.get(
        "worker_tasks",
        [],
    )

    for task in tasks:
        task.cancel()

    if tasks:
        await asyncio.gather(
            *tasks,
            return_exceptions=True,
        )

    logging.info("AI workers stopped")


# ============================================================
# MAIN
# ============================================================

def main():

    logging.basicConfig(
        level=logging.INFO,
        format=(
            "%(asctime)s | "
            "%(levelname)s | "
            "%(name)s | "
            "%(message)s"
        ),
    )

    start_keep_alive()

    application = (
        Application.builder()
        .token(BOT_TOKEN)
        .connect_timeout(15.0)
        .read_timeout(15.0)
        .write_timeout(15.0)
        .pool_timeout(15.0)
        .post_init(post_init)
        .post_shutdown(post_shutdown)
        .build()
    )

    # --------------------------------------------------------
    # Welcome messages
    # --------------------------------------------------------

    application.add_handler(
        MessageHandler(
            filters.StatusUpdate.NEW_CHAT_MEMBERS,
            welcome,
        )
    )

    # --------------------------------------------------------
    # Stickers
    # --------------------------------------------------------

    application.add_handler(
        MessageHandler(
            filters.Sticker.ALL,
            handle_sticker,
        )
    )

    # --------------------------------------------------------
    # Images / GIFs / Videos / Documents
    # --------------------------------------------------------

    application.add_handler(
        MessageHandler(
            (
                filters.PHOTO
                | filters.ANIMATION
                | filters.VIDEO
                | filters.Document.ALL
            ),
            handle_media,
        )
    )

    # --------------------------------------------------------
    # Text
    # --------------------------------------------------------

    application.add_handler(
        MessageHandler(
            filters.TEXT & ~filters.COMMAND,
            handle_message,
        )
    )

    print()
    print("=" * 60)
    print("⚡ FAST TELEGRAM MODERATION BOT")
    print("=" * 60)
    print(f"Text AI workers : {TEXT_AI_WORKERS}")
    print(f"Media AI workers: {MEDIA_AI_WORKERS}")
    print(f"Text queue     : {AI_QUEUE_SIZE}")
    print(f"Media queue    : {MEDIA_QUEUE_SIZE}")
    print("Local moderation: ENABLED")
    print("Admin caching   : ENABLED")
    print("AI queue        : ENABLED")
    print("5-minute mute   : ENABLED")
    print("=" * 60)
    print()

    application.run_polling(
        allowed_updates=Update.ALL_TYPES,
        drop_pending_updates=False,
    )


if __name__ == "__main__":
    main()
